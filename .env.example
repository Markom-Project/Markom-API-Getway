# ─────────────────────────────────────────────────────────────
# MarKom Gateway — Environment Configuration (Template)
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── LLM Provider API Keys ──────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
COHERE_API_KEY=""
AZURE_API_BASE=""
AZURE_API_VERSION=""
AZURE_API_KEY=""
REPLICATE_API_KEY=""
REPLICATE_API_TOKEN=""
NOVITA_API_KEY=""
INFINITY_API_KEY=""

# ── OpenRouter (optional) ───────────────────────────────────
OR_SITE_URL=""
OR_APP_NAME="MarKom Gateway"
OR_API_KEY=""

# ── Infisical (optional) ───────────────────────────────────
INFISICAL_TOKEN=""

# ─────────────────────────────────────────────────────────────
# MarKom Gateway — Core Settings
# ─────────────────────────────────────────────────────────────

MARKOM_MASTER_KEY="sk-markom-secret-key-change-me"
LITELLM_MASTER_KEY="sk-markom-secret-key-change-me"

# ─────────────────────────────────────────────────────────────
# Database — Postgres
# ─────────────────────────────────────────────────────────────
# "true" = run local Postgres container
# "false" = use external DB (NeonDB, RDS, etc.)

MARKOM_POSTGRES_ENABLED="true"
DATABASE_URL="postgresql://llmproxy:dbpassword9090@db:5432/litellm"
MARKOM_AUDIT_DB_URL=""
MARKOM_ADMIN_DB_URL=""
STORE_MODEL_IN_DB="True"

# ─────────────────────────────────────────────────────────────
# Redis — Health Metrics + Caching
# ─────────────────────────────────────────────────────────────
# "true" = run local Redis container
# "false" = health router uses in-memory fallback

MARKOM_REDIS_ENABLED="true"
MARKOM_REDIS_URL="redis://redis:6379"

# ─────────────────────────────────────────────────────────────
# Semantic Cache
# ─────────────────────────────────────────────────────────────
# "faiss" = local (default, no external service needed)
# "pinecone" = cloud (set PINECONE_API_KEY below)

MARKOM_CACHE_BACKEND="faiss"
MARKOM_EMBEDDING_MODEL="text-embedding-3-small"
MARKOM_CACHE_SIMILARITY_THRESHOLD="0.95"
MARKOM_CACHE_TTL="3600"
MARKOM_CACHE_MAX_ENTRIES="10000"
MARKOM_CACHE_SKIP_MODELS=""

# ─────────────────────────────────────────────────────────────
# Health Router
# ─────────────────────────────────────────────────────────────

MARKOM_SCORING_WINDOW="300"
MARKOM_EXPLORATION_RATE="0.02"
MARKOM_LATENCY_WEIGHT="0.4"
MARKOM_ERROR_WEIGHT="0.4"
MARKOM_TIMEOUT_WEIGHT="0.2"

# ─────────────────────────────────────────────────────────────
# Audit Trail
# ─────────────────────────────────────────────────────────────

MARKOM_AUDIT_REDACT_CONTENT="false"
MARKOM_AUDIT_RETENTION_DAYS="90"

# ─────────────────────────────────────────────────────────────
# PII Guardrail (disabled by default)
# ─────────────────────────────────────────────────────────────

MARKOM_PII_ENABLED="false"
MARKOM_PII_BLOCK_ON_DETECTION="false"

# ─────────────────────────────────────────────────────────────
# Pinecone (future upgrade)
# ─────────────────────────────────────────────────────────────

PINECONE_API_KEY=""
PINECONE_INDEX_NAME=""
PINECONE_NAMESPACE="markom-cache"

# ─────────────────────────────────────────────────────────────
# Admin Service
# ─────────────────────────────────────────────────────────────

LITELLM_PROXY_URL="http://litellm:4000"
MARKOM_ADMIN_PORT="8000"

# ─────────────────────────────────────────────────────────────
# Monitoring — Prometheus
# ─────────────────────────────────────────────────────────────
# "true" = run local Prometheus container
# "false" = skip (use external or disable)

MARKOM_PROMETHEUS_ENABLED="true"
PROMETHEUS_HOST="0.0.0.0"
PROMETHEUS_PORT="9090"

# ─────────────────────────────────────────────────────────────
# Monitoring — Grafana
# ─────────────────────────────────────────────────────────────
# "true" = run local Grafana container (auto-connects to Prometheus)
# "false" = skip (use external or disable)
# Default login: admin / admin

MARKOM_GRAFANA_ENABLED="true"
GRAFANA_HOST="0.0.0.0"
GRAFANA_PORT="3000"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"
GRAFANA_ALLOW_SIGN_UP="false"

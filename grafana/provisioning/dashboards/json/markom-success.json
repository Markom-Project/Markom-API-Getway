{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Success Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(litellm_request_total{status=\"success\"}[5m])) / sum(rate(litellm_request_total[5m])) * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "title": "Successful Requests / min",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(litellm_request_total{status=\"success\"}[5m])) * 60",
          "legendFormat": "Successes/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#22c55e" },
          "unit": "reqpm"
        }
      }
    },
    {
      "title": "Total Successful Requests (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(litellm_request_total{status=\"success\"}[24h]))",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#22c55e" },
          "unit": "short"
        }
      }
    },
    {
      "title": "Cache Hit Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(litellm_cache_hits_total[5m])) / sum(rate(litellm_request_total[5m])) * 100",
          "legendFormat": "Cache Hit %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "title": "Average Cost per Request",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(litellm_request_cost_total{status=\"success\"}[5m])) / sum(rate(litellm_request_total{status=\"success\"}[5m]))",
          "legendFormat": "Avg Cost",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#120505" },
          "unit": "currencyUSD"
        }
      }
    },
    {
      "title": "Success Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(litellm_request_total{status=\"success\"}[5m])) / sum(rate(litellm_request_total[5m])) * 100",
          "legendFormat": "Success Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#22c55e" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "gradientMode": "scheme"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "title": "Success by Model",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (model) (increase(litellm_request_total{status=\"success\"}[1h]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Tokens Consumed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(litellm_prompt_tokens_total{status=\"success\"}[5m]))",
          "legendFormat": "Prompt Tokens/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(litellm_completion_tokens_total{status=\"success\"}[5m]))",
          "legendFormat": "Completion Tokens/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        }
      }
    },
    {
      "title": "Total Cost (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(litellm_request_cost_total{status=\"success\"}[1h]))",
          "legendFormat": "Hourly Cost",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#120505" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never"
          },
          "unit": "currencyUSD"
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["litellm", "markom", "success"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MarKom Gateway — Success",
  "uid": "markom-success",
  "version": 1
